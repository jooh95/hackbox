# Copy to .env and fill in what you have. Hackbox runs fully end-to-end
# without any of these — it falls back to a local mock scanner and a local
# load-generator process — but real runs need real credentials.

# --- Daytona (vulnerability scanning sandbox) ---
# Leave empty to use the built-in mock scanner (real HTTP checks, no Daytona account needed).
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# --- Nosana (distributed load testing) ---
# Leave empty to run the load generator as a local process instead of a real Nosana job.
# NOSANA_WALLET_PRIVATE_KEY must be either a path to a Solana keypair JSON file
# (e.g. ~/.nosana/nosana_key.json) or the JSON array contents of one.
NOSANA_WALLET_PRIVATE_KEY=
NOSANA_NETWORK=mainnet
NOSANA_MARKET=
NOSANA_RPC_URL=

# --- Tunnel (exposes a local target to Daytona/Nosana temporarily) ---
TUNNEL_PROVIDER=cloudflared

# --- Server ---
SERVER_PORT=8787

# --- Report export ---
# Override if Chrome isn't at the default macOS/Linux install path.
HACKBOX_CHROME_PATH=
